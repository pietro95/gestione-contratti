# Copiare in /appdata/gestione-contratti/config/.env sul server (permessi 600; mai committare
# il .env). Valori di esempio, nessun segreto reale. Generare password e chiavi con:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# (solo esadecimali: niente caratteri da codificare nell'URL del database).

# --- Esposizione sul server Docker (letti da deploy/deploy.sh e da Docker Compose) ---
# Porta NON standard e libera sul server: deploy.sh verifica che non sia già in uso.
APP_PORT=18471
# 127.0.0.1 se il proxy gira sull'host; con Nginx Proxy Manager (in un container) il gateway del
# bridge Docker, es. 172.17.0.1 (RUNBOOK §5.1). Mai 0.0.0.0 senza firewall.
APP_BIND=127.0.0.1
# Facoltativo: opzioni di gunicorn (default --workers 3 --timeout 60)
# GUNICORN_CMD_ARGS=--workers 3 --timeout 60

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.prod
# Stringa lunga e casuale: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=cambiami-stringa-lunga-casuale
DJANGO_ALLOWED_HOSTS=contratti.siciliacque.local
DJANGO_CSRF_TRUSTED_ORIGINS=https://contratti.siciliacque.local
# Facoltativi (prod): HSTS in secondi e redirect HTTPS lato Django (di norma lo fa il proxy)
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_SSL_REDIRECT=false
# Facoltativi: livello di log (root) e durata della sessione in secondi (default 8 ore)
DJANGO_LOG_LEVEL=WARNING
SESSION_COOKIE_AGE=28800

# --- Database (PostgreSQL 16, container "db" dello stack) ---
# POSTGRES_* creano il database al primo avvio; DATABASE_URL deve usare la stessa password.
POSTGRES_USER=contratti
POSTGRES_PASSWORD=cambiami-password-esadecimale
POSTGRES_DB=contratti
DATABASE_URL=postgres://contratti:cambiami-password-esadecimale@db:5432/contratti
# Facoltativo: durata delle connessioni persistenti in secondi
DATABASE_CONN_MAX_AGE=60

# --- LDAP / Active Directory ---
# Se LDAP_SERVER_URI è vuota: solo login locale (sviluppo).
# Mai bind in chiaro: ldaps://...:636, oppure ldap://...:389 con LDAP_START_TLS=true.
LDAP_SERVER_URI=ldaps://dc01.siciliacque.local:636
LDAP_START_TLS=false
# Certificato della CA interna (montato da file). Se manca, l'app non parte (check accounts.E001).
# Sul server: /appdata/gestione-contratti/config/certs/ca-interna.pem, montato nel container qui:
LDAP_CA_CERT_FILE=/etc/gestione-contratti/certs/ca-interna.pem
# Account di servizio in sola lettura per la ricerca degli utenti
LDAP_BIND_DN=CN=svc_contratti,OU=Service Accounts,DC=siciliacque,DC=local
LDAP_BIND_PASSWORD=
LDAP_USER_SEARCH_BASE=DC=siciliacque,DC=local
LDAP_USER_FILTER=(sAMAccountName=%(user)s)
LDAP_GROUP_SEARCH_BASE=DC=siciliacque,DC=local
LDAP_GROUP_FILTER=(objectClass=group)
# Gruppi AD dei ruoli (DN completi). Con più gruppi vale il ruolo più alto.
LDAP_GROUP_ADMIN=CN=GG_Contratti_Admin,OU=Gruppi,DC=siciliacque,DC=local
LDAP_GROUP_EDITOR=CN=GG_Contratti_Editor,OU=Gruppi,DC=siciliacque,DC=local
LDAP_GROUP_READER=CN=GG_Contratti_Reader,OU=Gruppi,DC=siciliacque,DC=local
# Gruppi annidati: matching_rule (AD, una query con 1.2.840.113556.1.4.1941),
# recursive (qualsiasi server, una query per livello), none (solo appartenenza diretta)
LDAP_NESTED_GROUPS=matching_rule
# Timeout di rete e di operazione in secondi
LDAP_TIMEOUT=5
# Livello di log di django_auth_ldap (DEBUG solo per diagnosi)
LDAP_LOG_LEVEL=WARNING

# --- Account di emergenza (break-glass) ---
# Si crea con: python manage.py crea_breakglass (password digitata, mai in variabili)
BREAKGLASS_MIN_PASSWORD_LENGTH=24

# --- Parametri applicativi ---
APP_TIME_ZONE=Europe/Rome

# --- Connettore MCP (F10, docs/SPEC_MCP.md, RUNBOOK §12) ---
# Lasciare MCP_PORT vuota (o commentata) per non avviare il connettore.
# MCP_PORT=18472
# Indirizzo su cui ascolta il container mcp (come APP_BIND).
# MCP_BIND=127.0.0.1
# Nome DNS pubblico dell'host dedicato e URL pubblico (https://MCP_HOST, senza percorso).
# MCP_HOST=mcp-contratti.esempio.it
# MCP_URL_PUBBLICO=https://mcp-contratti.esempio.it
# URL interno dell'applicazione: login e consenso del connettore (stesso host dell'interfaccia).
# MCP_URL_INTERNO=https://contratti.siciliacque.local
# Utente PostgreSQL limitato del container mcp (diverso da POSTGRES_USER, password esadecimale).
# Lo crea deploy.sh (manage.py ruolo_db_mcp).
# MCP_DATABASE_URL=postgres://contratti_mcp:cambiami-password-esadecimale@db:5432/contratti
# Facoltativo: durata dell'access token in secondi (default 3600)
# MCP_ACCESS_TOKEN_SECONDI=3600

# --- Backup (container "backup"; file in /appdata/gestione-contratti/backup) ---
# Ora del dump giornaliero (Europe/Rome) e giorni di conservazione. Lo storico lungo è nel
# backup della VM, che include la cartella dei dump.
BACKUP_ORA=02:30
BACKUP_GIORNI=14

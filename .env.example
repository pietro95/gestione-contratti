# Copiare in .env sulla VM (mai committare .env). Valori di esempio, nessun segreto reale.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.prod
# Stringa lunga e casuale: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=cambiami-stringa-lunga-casuale
DJANGO_ALLOWED_HOSTS=contratti.siciliacque.local
DJANGO_CSRF_TRUSTED_ORIGINS=https://contratti.siciliacque.local
# Facoltativi (prod): HSTS in secondi e redirect HTTPS lato Django (di norma lo fa il proxy)
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_SSL_REDIRECT=false
# Facoltativi: livello di log (root) e durata della sessione in secondi (default 8 ore)
DJANGO_LOG_LEVEL=WARNING
SESSION_COOKIE_AGE=28800

# --- Database (PostgreSQL 16) ---
DATABASE_URL=postgres://contratti:PASSWORD@db:5432/contratti
# Facoltativo: durata delle connessioni persistenti in secondi
DATABASE_CONN_MAX_AGE=60

# --- LDAP / Active Directory ---
# Se LDAP_SERVER_URI è vuota: solo login locale (sviluppo).
# Mai bind in chiaro: ldaps://...:636, oppure ldap://...:389 con LDAP_START_TLS=true.
LDAP_SERVER_URI=ldaps://dc01.siciliacque.local:636
LDAP_START_TLS=false
# Certificato della CA interna (montato da file). Se manca, l'app non parte (check accounts.E001).
LDAP_CA_CERT_FILE=/etc/ssl/certs/ca-interna.pem
# Account di servizio in sola lettura per la ricerca degli utenti
LDAP_BIND_DN=CN=svc_contratti,OU=Service Accounts,DC=siciliacque,DC=local
LDAP_BIND_PASSWORD=
LDAP_USER_SEARCH_BASE=DC=siciliacque,DC=local
LDAP_USER_FILTER=(sAMAccountName=%(user)s)
LDAP_GROUP_SEARCH_BASE=DC=siciliacque,DC=local
LDAP_GROUP_FILTER=(objectClass=group)
# Gruppi AD dei ruoli (DN completi). Con più gruppi vale il ruolo più alto.
LDAP_GROUP_ADMIN=CN=GG_Contratti_Admin,OU=Gruppi,DC=siciliacque,DC=local
LDAP_GROUP_EDITOR=CN=GG_Contratti_Editor,OU=Gruppi,DC=siciliacque,DC=local
LDAP_GROUP_READER=CN=GG_Contratti_Reader,OU=Gruppi,DC=siciliacque,DC=local
# Gruppi annidati: matching_rule (AD, una query con 1.2.840.113556.1.4.1941),
# recursive (qualsiasi server, una query per livello), none (solo appartenenza diretta)
LDAP_NESTED_GROUPS=matching_rule
# Timeout di rete e di operazione in secondi
LDAP_TIMEOUT=5
# Livello di log di django_auth_ldap (DEBUG solo per diagnosi)
LDAP_LOG_LEVEL=WARNING

# --- Account di emergenza (break-glass) ---
# Si crea con: python manage.py crea_breakglass (password digitata, mai in variabili)
BREAKGLASS_MIN_PASSWORD_LENGTH=24

# --- Parametri applicativi ---
APP_TIME_ZONE=Europe/Rome
